# Copie para .env e preencha. O .env não vai para o Git.

# --- API ---
NODE_ENV=development
PORT=3333

# Banco local do docker-compose. Em homologação, vem do painel do serviço.
DATABASE_URL=postgresql://gincana:gincana@localhost:5432/gincana

# Segredo de assinatura do token de sessão: mínimo de 32 caracteres.
# Gere o seu com: openssl rand -base64 32
JWT_SECRET=troque-este-valor-por-um-segredo-de-32-caracteres

# Endereços liberados no CORS, separados por vírgula.
CORS_ORIGINS=http://localhost:5173

# --- Armazenamento de comprovantes ---
# Preenchido na Sprint 2, quando a US07 entrar. O segredo nunca vai ao navegador:
# a API assina o envio e o arquivo sobe direto do aparelho da pessoa.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Front ---
# Em desenvolvimento o Vite redireciona /api para a API local; em produção,
# aponte para a URL pública da API.
VITE_API_URL=/api
