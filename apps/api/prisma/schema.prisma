// Modelo de dados da Gincana Solidária da Cestacorp.
//
// Três decisões sustentam tudo o que o sistema promete à cliente:
//
//  1. A regra de pontuação fica em cadastro e tem vigência. Mudar a pontuação no meio da
//     gincana é fechar a vigência atual e abrir outra, nunca sobrescrever.
//  2. O lançamento congela a regra aplicada e o valor usado. Mudança futura de regra não
//     altera o que já foi apurado — é o que a tela de regras promete em texto.
//  3. Toda alteração de pontuação gera registro de auditoria, gravado na mesma transação.
//
// Arquivo de dono único: alterações vêm em pull request isolado. Ver CONTRIBUTING.md.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// A URL de conexão fica em prisma.config.ts, não aqui: a partir do Prisma 7 o schema
// não carrega mais credencial. Ver apps/api/prisma.config.ts.

datasource db {
  provider = "postgresql"
}

enum Papel {
  COLABORADOR
  LIDER
  ADMIN
}

enum StatusGincana {
  PLANEJADA
  ATIVA
  ENCERRADA
}

enum StatusLancamento {
  PENDENTE
  APROVADO
  RECUSADO
}

enum Unidade {
  KG
  UNIDADE
  PECA
  CERTIFICADO
}

enum AcaoAuditoria {
  CRIACAO
  APROVACAO
  RECUSA
  ALTERACAO
  EXCLUSAO
}

model Colaborador {
  id        String  @id @default(uuid())
  nome      String
  email     String  @unique
  senhaHash String
  papel     Papel   @default(COLABORADOR)
  ativo     Boolean @default(true)

  // Desativar em vez de apagar preserva a trilha de auditoria de quem já saiu (LGPD:
  // o expurgo definitivo é um procedimento à parte, não um efeito colateral).
  equipeId String?
  equipe   Equipe? @relation("MembrosDaEquipe", fields: [equipeId], references: [id])

  equipeLiderada Equipe?             @relation("LiderDaEquipe")
  lancamentos    Lancamento[]
  avaliacoes     Lancamento[]        @relation("AvaliadorDoLancamento")
  evidencias     Evidencia[]
  auditorias     RegistroAuditoria[]
  regrasCriadas  RegraPontuacao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([equipeId])
  @@map("colaboradores")
}

model Gincana {
  id         String        @id @default(uuid())
  ano        Int           @unique
  nome       String
  dataInicio DateTime      @db.Date
  dataFim    DateTime      @db.Date
  status     StatusGincana @default(PLANEJADA)

  equipes     Equipe[]
  tiposAcao   TipoAcao[]
  lancamentos Lancamento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status])
  @@map("gincanas")
}

model Equipe {
  id        String  @id @default(uuid())
  nome      String
  gincanaId String
  gincana   Gincana @relation(fields: [gincanaId], references: [id], onDelete: Cascade)

  // Uma pessoa lidera no máximo uma equipe: é o que torna a autorização de aprovação
  // uma checagem simples e sem ambiguidade.
  liderId String?      @unique
  lider   Colaborador? @relation("LiderDaEquipe", fields: [liderId], references: [id])

  membros     Colaborador[] @relation("MembrosDaEquipe")
  lancamentos Lancamento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([gincanaId, nome])
  @@index([gincanaId])
  @@map("equipes")
}

model TipoAcao {
  id        String  @id @default(uuid())
  gincanaId String
  gincana   Gincana @relation(fields: [gincanaId], references: [id], onDelete: Cascade)

  nome      String
  descricao String?
  unidade   Unidade

  // Curso exige certificado anexado; uma atitude pode não exigir nada.
  exigeEvidencia Boolean @default(true)

  // Pausar um tipo de ação não apaga o histórico de quem já pontuou com ele.
  ativo Boolean @default(true)

  regras      RegraPontuacao[]
  lancamentos Lancamento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([gincanaId, nome])
  @@index([gincanaId, ativo])
  @@map("tipos_acao")
}

model RegraPontuacao {
  id         String   @id @default(uuid())
  tipoAcaoId String
  tipoAcao   TipoAcao @relation(fields: [tipoAcaoId], references: [id], onDelete: Cascade)

  pontosPorUnidade Decimal @db.Decimal(10, 2)

  // Vigência fechada no início e aberta no fim: no instante da virada já vale a nova
  // regra, sem buraco nem sobreposição. Nulo em vigenciaFim significa "é a regra atual".
  vigenciaInicio DateTime
  vigenciaFim    DateTime?

  criadoPorId String
  criadoPor   Colaborador @relation(fields: [criadoPorId], references: [id])

  lancamentos Lancamento[]

  criadoEm DateTime @default(now())

  @@index([tipoAcaoId, vigenciaInicio])
  @@index([tipoAcaoId, vigenciaFim])
  @@map("regras_pontuacao")
}

model Lancamento {
  id String @id @default(uuid())

  gincanaId String
  gincana   Gincana @relation(fields: [gincanaId], references: [id])

  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])

  // A equipe é gravada no lançamento, e não lida do colaborador na hora de somar: se
  // alguém mudar de equipe no meio da gincana, os pontos ficam onde foram conquistados.
  equipeId String
  equipe   Equipe @relation(fields: [equipeId], references: [id])

  tipoAcaoId String
  tipoAcao   TipoAcao @relation(fields: [tipoAcaoId], references: [id])

  quantidade Decimal @db.Decimal(10, 3)

  // Regra e valor congelados no momento do lançamento.
  regraPontuacaoId         String
  regraPontuacao           RegraPontuacao @relation(fields: [regraPontuacaoId], references: [id])
  pontosPorUnidadeAplicado Decimal        @db.Decimal(10, 2)
  pontosCalculados         Int

  status     StatusLancamento @default(PENDENTE)
  observacao String?
  dataAcao   DateTime         @db.Date

  avaliadoPorId String?
  avaliadoPor   Colaborador? @relation("AvaliadorDoLancamento", fields: [avaliadoPorId], references: [id])
  avaliadoEm    DateTime?
  motivoRecusa  String?

  evidencias Evidencia[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Fila do avaliador e apuração da gincana
  @@index([gincanaId, status])
  // Placar por equipe
  @@index([equipeId, status])
  // "Meus lançamentos" do colaborador
  @@index([colaboradorId, status])
  @@map("lancamentos")
}

model Evidencia {
  id           String     @id @default(uuid())
  lancamentoId String
  lancamento   Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)

  url      String
  // Identificador no armazenamento externo: é o que permite remover o arquivo depois.
  publicId String

  nomeArquivo  String
  mimeType     String
  tamanhoBytes Int

  enviadoPorId String
  enviadoPor   Colaborador @relation(fields: [enviadoPorId], references: [id])

  criadoEm DateTime @default(now())

  @@index([lancamentoId])
  @@map("evidencias")
}

model RegistroAuditoria {
  id String @id @default(uuid())

  // Tabela somente-inclusão: nunca sofre UPDATE nem DELETE. É a evidência que sustenta
  // o selo de qualidade contábil.
  entidade   String
  entidadeId String
  acao       AcaoAuditoria

  autorId String
  autor   Colaborador @relation(fields: [autorId], references: [id])

  valoresAntes  Json?
  valoresDepois Json?
  descricao     String?

  criadoEm DateTime @default(now())

  @@index([entidade, entidadeId, criadoEm])
  @@index([autorId])
  @@map("registros_auditoria")
}
